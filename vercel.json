{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?p=:path*"
    },
    {
      "source": "/((?!api$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{server/**,node_modules/@sparticuz/chromium/**,node_modules/playwright-core/**}"
    }
  }
}
